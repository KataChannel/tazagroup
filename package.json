{
  "name": "tazav1-enterprise",
  "version": "2.0.0",
  "description": "Tazav1 Enterprise Platform - Production-ready full-stack platform with automated deployment & Human Resource Management",
  "private": true,
  "workspaces": [
    "site",
    "api"
  ],
  "scripts": {
    "dev": "concurrently \"bun run dev:site\" \"bun run dev:api\"",
    "dev:site": "cd site && bun run dev",
    "dev:api": "cd api && bun run start:dev",
    "build": "bun run build:api && bun run build:site",
    "build:site": "cd site && bun run build",
    "build:api": "cd api && bun run build",
    "start": "concurrently \"bun run start:site\" \"bun run start:api\"",
    "start:site": "cd site && bun run start",
    "start:api": "cd api && bun run start:prod",
    "install:all": "bun install && cd site && bun install && cd ../api && bun install",
    "clean": "rm -rf site/node_modules api/node_modules site/.next api/dist",
    "test": "cd api && bun run test",
    "lint": "bun run lint:site && bun run lint:api",
    "lint:site": "cd site && bun run lint",
    "lint:api": "cd api && bun run lint",
    "seed:hrm": "cd site && bun run app/seed/hrm-seed.ts",
    "deploy": "./3pushauto.sh",
    "backup": "./4backup.sh",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:build": "docker-compose build",
    "docker:restart": "docker-compose restart"
  },
  "keywords": [
    "tazav1",
    "enterprise",
    "hrm",
    "human-resource-management",
    "full-stack",
    "nextjs",
    "nestjs",
    "typescript",
    "remote-deployment",
    "docker",
    "nginx",
    "ssl",
    "production",
    "postgresql",
    "redis",
    "minio",
    "jwt-auth",
    "role-based-access",
    "bun",
    "prisma",
    "automated-deployment"
  ],
  "author": "Tazav1 Team",
  "license": "MIT",
  "homepage": "https://github.com/chikiet/Tazav1",
  "repository": {
    "type": "git",
    "url": "https://github.com/chikiet/Tazav1.git"
  },
  "bugs": {
    "url": "https://github.com/chikiet/Tazav1/issues"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.0.0"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@types/minimatch": "^6.0.0"
  }
}
