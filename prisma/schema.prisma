// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id               String    @id @default(cuid())
  name             String?
  email            String    @unique
  emailVerified    DateTime?
  image            String?
  password         String?
  role             UserRole  @default(PUBLISHER)
  isActive         Boolean   @default(true)
  isVerified       Boolean   @default(false)
  resetToken       String?
  resetTokenExpiry DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  lastActivityAt   DateTime?

  // Payout Settings
  minimumPayout         Float?   @default(100000)
  autoPayoutEnabled     Boolean  @default(false)
  payoutThreshold       Float?   @default(500000)
  holdPayouts           Boolean  @default(false)
  preferredPayoutMethod String?  @default("BANK_TRANSFER")
  payoutDay             Int?     @default(1)
  taxWithholding        Float?   @default(0)
  payoutCurrency        String?  @default("VND")

  // Relations
  accounts          Account[]
  sessions          Session[]
  profile           UserProfile?
  campaigns         CampaignUser[]
  clicks            Click[]
  conversions       Conversion[]
  payments          Payment[]
  activities        Activity[]
  favoriteCampaigns FavoriteCampaign[]
  notifications     Notification[]
  affiliateLinks    AffiliateLink[]
  payoutSchedule    PayoutSchedule?
  scheduledPayouts  ScheduledPayout[]
  taxReports        TaxReport[]
}

model UserProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  firstName   String?
  lastName    String?
  phone       String?
  address     String?
  city        String?
  country     String   @default("VN")
  bankName    String?
  bankAccount String?
  bankOwner   String?
  taxCode     String?
  website     String?
  company     String?
  bio         String?
  avatar      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Campaign {
  id          String         @id @default(cuid())
  name        String
  description String
  image       String?
  category    String
  commission  Float
  currency    String         @default("VND")
  status      CampaignStatus @default(ACTIVE)
  startDate   DateTime
  endDate     DateTime?
  url         String
  rules       String?
  isPrivate   Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  // Relations
  users          CampaignUser[]
  clicks         Click[]
  conversions    Conversion[]
  favorites      FavoriteCampaign[]
  notifications  Notification[]
  affiliateLinks AffiliateLink[]
}

model CampaignUser {
  id         String             @id @default(cuid())
  userId     String
  campaignId String
  status     CampaignUserStatus @default(PENDING)
  appliedAt  DateTime           @default(now())
  approvedAt DateTime?
  rejectedAt DateTime?
  reason     String?

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([userId, campaignId])
}

model Click {
  id         String   @id @default(cuid())
  userId     String
  campaignId String
  ip         String
  userAgent  String?
  referer    String?
  country    String?
  device     String?
  browser    String?
  os         String?
  clickedAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id])
  campaign Campaign @relation(fields: [campaignId], references: [id])
}

model Conversion {
  id          String           @id @default(cuid())
  userId      String
  campaignId  String
  orderId     String?
  amount      Float
  commission  Float
  currency    String           @default("VND")
  ip          String
  userAgent   String?
  status      ConversionStatus @default(PENDING)
  convertedAt DateTime         @default(now())
  approvedAt  DateTime?

  user     User     @relation(fields: [userId], references: [id])
  campaign Campaign @relation(fields: [campaignId], references: [id])
}

model Payment {
  id          String        @id @default(cuid())
  userId      String
  amount      Float
  currency    String        @default("VND")
  method      PaymentMethod
  status      PaymentStatus @default(PENDING)
  reference   String?
  description String?
  paidAt      DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model Activity {
  id          String       @id @default(cuid())
  userId      String
  type        ActivityType
  title       String
  description String
  metadata    String? // JSON string
  createdAt   DateTime     @default(now())

  user User @relation(fields: [userId], references: [id])
}

model FavoriteCampaign {
  id         String   @id @default(cuid())
  userId     String
  campaignId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([userId, campaignId])
}

model Notification {
  id         String           @id @default(cuid())
  userId     String
  title      String
  message    String
  type       NotificationType
  campaignId String?
  actionUrl  String?
  isRead     Boolean          @default(false)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@map("notifications")
}

model AffiliateLink {
  id          String    @id @default(cuid())
  userId      String
  campaignId  String
  originalUrl String
  shortCode   String    @unique
  customAlias String?
  title       String?
  description String?
  tags        String[]  @default([])
  isActive    Boolean   @default(true)
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Analytics data
  totalClicks      Int       @default(0)
  totalConversions Int       @default(0)
  totalRevenue     Float     @default(0)
  lastClickAt      DateTime?

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign    Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  clicks      LinkClick[]
  conversions LinkConversion[]
  analytics   LinkAnalytics[]

  @@map("affiliate_links")
}

model LinkClick {
  id        String   @id @default(cuid())
  linkId    String
  ip        String
  userAgent String?
  referer   String?
  country   String?
  region    String?
  city      String?
  device    String?
  browser   String?
  os        String?
  screen    String?
  language  String?
  timezone  String?
  clickedAt DateTime @default(now())

  link AffiliateLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@map("link_clicks")
}

model LinkConversion {
  id          String   @id @default(cuid())
  linkId      String
  clickId     String?
  orderId     String?
  amount      Float
  commission  Float
  currency    String   @default("VND")
  ip          String
  userAgent   String?
  country     String?
  device      String?
  browser     String?
  convertedAt DateTime @default(now())

  link AffiliateLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@map("link_conversions")
}

model LinkAnalytics {
  id             String   @id @default(cuid())
  linkId         String
  date           DateTime
  clicks         Int      @default(0)
  conversions    Int      @default(0)
  revenue        Float    @default(0)
  ctr            Float    @default(0) // Click-through rate
  conversionRate Float    @default(0)
  avgRevenue     Float    @default(0)

  // Geographic data
  topCountries Json?
  topCities    Json?

  // Device data  
  deviceTypes      Json?
  browsers         Json?
  operatingSystems Json?

  // Traffic sources
  referrers Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  link AffiliateLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@unique([linkId, date])
  @@map("link_analytics")
}

model PayoutSchedule {
  id             String             @id @default(cuid())
  userId         String
  frequency      PayoutFrequency    @default(MONTHLY)
  dayOfMonth     Int?               // For monthly (1-31)
  dayOfWeek      Int?               // For weekly (0-6)
  minimumAmount  Float              @default(100000) // Default 100,000 VND
  isActive       Boolean            @default(true)
  nextPayoutDate DateTime?
  lastPayoutDate DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  payouts ScheduledPayout[]

  @@unique([userId])
  @@map("payout_schedules")
}

model ScheduledPayout {
  id               String              @id @default(cuid())
  userId           String
  scheduleId       String
  amount           Float
  currency         String              @default("VND")
  status           ScheduledPayoutStatus @default(PENDING)
  scheduledDate    DateTime
  processedDate    DateTime?
  paymentId        String?             // Reference to Payment when processed
  reason           String?             // For failed/cancelled payouts
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  schedule PayoutSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@map("scheduled_payouts")
}

model TaxReport {
  id              String        @id @default(cuid())
  userId          String
  year            Int
  quarter         Int?          // Optional for quarterly reports
  totalIncome     Float
  totalCommission Float
  taxableIncome   Float
  taxAmount       Float
  taxRate         Float
  taxType         TaxType       @default(PERSONAL)
  status          TaxReportStatus @default(DRAFT)
  dueDate         DateTime
  submittedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year, quarter])
  @@map("tax_reports")
}

// Enums
enum UserRole {
  ADMIN
  PUBLISHER
  ADVERTISER
}

enum CampaignStatus {
  ACTIVE
  INACTIVE
  PENDING
  REJECTED
}

enum CampaignUserStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ConversionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentMethod {
  BANK_TRANSFER
  PAYPAL
  STRIPE
  MOMO
  ZALOPAY
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum ActivityType {
  LOGIN
  LOGOUT
  REGISTER
  CAMPAIGN_APPLY
  CAMPAIGN_APPROVE
  CAMPAIGN_REJECT
  CLICK
  CONVERSION
  PAYMENT
  PROFILE_UPDATE
}

enum NotificationType {
  CAMPAIGN_NEW
  CAMPAIGN_APPROVED
  CAMPAIGN_REJECTED
  CAMPAIGN_UPDATED
  CAMPAIGN_ENDING
  PAYMENT_PROCESSED
  PAYMENT_FAILED
  SYSTEM_UPDATE
  ACHIEVEMENT
  REMINDER
}

enum PayoutFrequency {
  WEEKLY
  MONTHLY
  QUARTERLY
}

enum ScheduledPayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum TaxType {
  PERSONAL
  BUSINESS
}

enum TaxReportStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}
